rules_version = '2';

// Reglas básicas: solo usuarios autenticados (empleados con cuenta creada
// en Firebase Authentication) pueden leer y escribir datos del sistema.
service cloud.firestore {
  match /databases/{database}/documents {
    // Perfil de cada empleado (usuario, correo) creado durante el registro.
    // Solo el propio dueño de la cuenta puede crear o modificar su perfil.
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    match /productos/{productoId} {
      allow read, write: if request.auth != null;
    }
    match /ventas/{ventaId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false; // las ventas no se editan ni se borran
    }
    match /devoluciones/{devolucionId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;
    }
    // Contador atómico usado para asignar el folio secuencial de cada venta
    // (ej. FOL-103) dentro de la misma transacción en que se crea la venta.
    match /contadores/{contadorId} {
      allow read, write: if request.auth != null;
    }
  }
}
